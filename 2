* {
    box-sizing: border-box;
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
}

body {
    background-color: #f4f7f6;
    color: #333;
}

header {
    background-color: #1b4332;
    color: white;
    text-align: center;
    padding: 2rem;
}

header h1 {
    margin-bottom: 10px;
}

.container {
    display: flex;
    flex-wrap: wrap;
    max-width: 1000px;
    margin: 20px auto;
    gap: 20px;
    padding: 0 10px;
}

.sidebar {
    flex: 1;
    min-width: 250px;
    background: white;
    padding: 20px;
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
}

.sidebar h3 {
    margin-bottom: 15px;
    color: #1b4332;
}

.btn {
    display: block;
    width: 100%;
    padding: 12px;
    margin-bottom: 10px;
    background-color: #2d6a4f;
    color: white;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    font-size: 16px;
    transition: 0.3s;
}

.btn:hover {
    background-color: #1b4332;
}

.content {
    flex: 2;
    min-width: 300px;
    background: white;
    padding: 25px;
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
}

.content h2 {
    color: #1b4332;
    margin-bottom: 15px;
}

.content p {
    line-height: 1.6;
    margin-bottom: 20px;
}

.details h4 {
    margin-top: 15px;
    color: #40916c;
}

.details ul {
    margin-right: 20px;
    margin-top: 5px;
    line-height: 1.8;
}
